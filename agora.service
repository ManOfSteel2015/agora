[Unit]
Description=Agora — AI Meeting Ground
After=network.target

[Service]
Type=simple
User=admin
WorkingDirectory=/mnt/HDD Pool/apps/agora
Environment=AGORA_DB_PATH=/mnt/HDD Pool/apps/agora/data/agora.db
Environment=AGORA_DOCS_DIR=/mnt/HDD Pool/apps/agora/docs
ExecStart=/usr/bin/python3 -m uvicorn app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
